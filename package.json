{
  "name": "flappie-api",
  "version": "0.4.0",
  "description": "Control your Flappie cat door from Node or the terminal. Typed TypeScript client with full CRUD for time plans, settings, and prey events. Unofficial, not associated with Flappie Technologies AG.",
  "type": "module",
  "license": "MIT",
  "author": "Olivier Oswald (https://github.com/ooswald)",
  "homepage": "https://github.com/ooswald/flappie-api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ooswald/flappie-api.git"
  },
  "bugs": {
    "url": "https://github.com/ooswald/flappie-api/issues"
  },
  "keywords": [
    "flappie",
    "cat-door",
    "cat-flap",
    "smart-home",
    "home-automation",
    "api-client",
    "cli",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "flappie": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "API.md",
    "RE.md",
    "openapi.yaml",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "node --experimental-strip-types --no-warnings --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "commander": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "typescript": "^6.0.3"
  }
}
